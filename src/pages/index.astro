---
import Layout from '../layouts/Layout.astro';
import menuData from '../data/menu.json';
import { ArrowRight, ChefHat, Truck, Calendar, Star, Phone } from 'lucide-react';

const featuredItems = menuData.categories.flatMap(c =>
  c.subcategories.flatMap(s => s.items.slice(0, 1).map(i => ({ ...i, categoryName: c.name, subcategoryName: s.name })))
).slice(0, 4);
---

<Layout title="Početna">
  {/* Hero with food image */}
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden">
    {/* Background image */}
    <div class="absolute inset-0">
      <img
        src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=1920&q=80"
        alt="Delicious catering food spread"
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-black/60" />
      <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-black/30" />
    </div>

    <div class="relative z-10 max-w-5xl mx-auto px-4 text-left md:text-center">
      <p class="animate-fade-up font-body text-white/70 text-xs uppercase tracking-[0.25em] mb-6">
        Ketering za sve prilike
      </p>
      <h1 class="animate-fade-up delay-100 font-display text-6xl md:text-8xl lg:text-9xl text-white mb-6 leading-[0.95] font-bold">
        VAU Ketering
      </h1>
      <p class="animate-fade-up delay-200 text-lg md:text-xl text-white/80 max-w-2xl mx-auto mb-12 leading-relaxed">
        Od roštilja za vaše proslave do torti za porodične trenutke.
        <br>
        Kvalitetna hrana, dostava na adresu, užitak bez brige.
      </p>
      <div class="animate-fade-up delay-300 flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href={`${import.meta.env.BASE_URL}ponuda`}
          class="inline-flex items-center justify-center gap-2 px-10 py-4 bg-gold text-burgundy-dark font-display text-lg uppercase tracking-widest rounded-xl transition-all duration-300 hover:scale-[1.02] active:scale-[0.98]"
        >
          Pogledaj ponudu
          <ArrowRight size={20} strokeWidth={2} />
        </a>
        <a
          href={`https://wa.me/381641234567`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-10 py-4 border border-white/40 text-white font-display text-lg uppercase tracking-widest rounded-xl hover:bg-white hover:text-burgundy-dark transition-all duration-300"
        >
          <Phone size={18} strokeWidth={2} />
          Naruči odmah
        </a>
      </div>
    </div>
  </section>

    {/* About teaser */}
  <section class="py-20 md:py-28 bg-white">
    <div class="max-w-6xl mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-5 gap-12 items-center">
        <div class="relative md:col-span-3">
          <div class="aspect-[4/3] rounded-2xl overflow-hidden bg-cream">
            <img
              src="https://images.unsplash.com/photo-1556909114-f6e7ad7d3136?w=800&q=80"
              alt="VAU Ketering priprema hrane"
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
          <div class="absolute -bottom-4 -right-4 bg-white shadow-lg rounded-xl p-5 z-10">
            <p class="font-display text-3xl text-gold font-bold">500+</p>
            <p class="font-body text-xs text-muted uppercase tracking-wider">Proslava</p>
          </div>
        </div>
        <div class="md:col-span-2">
          <p class="text-muted text-xs uppercase tracking-[0.2em] mb-3">O nama</p>
          <h2 class="font-display text-4xl text-ink mb-6">Porodična priča o ljubavi prema hrani</h2>
          <p class="text-lg text-ink-secondary leading-relaxed mb-6">
            VAU Ketering je nastao iz želje da najbolja domaća jela stignu do vaših stolova — 
            bilo da organizujete rođendan, poslovni ručak, venčanje ili porodičnu proslavu.
          </p>
          <p class="text-muted leading-relaxed mb-8">
            Sa dugogodišnjim iskustvom u pripremi keteringa, ponosno nudimo jela koja su spremljena 
            sa pažnjom i ljubavlju, koristeći isključivo sveže, lokalne namirnice.
          </p>
          <a
            href={`${import.meta.env.BASE_URL}o-nama`}
            class="inline-flex items-center gap-2 px-8 py-3 border-2 border-burgundy text-burgundy font-display text-sm uppercase tracking-widest rounded-xl hover:bg-burgundy hover:text-white transition-all duration-300"
          >
            Saznaj više
            <ArrowRight size={16} />
          </a>
        </div>
      </div>
    </div>
  </section>


    {/* Features */}
  <section class="py-20 md:py-24 bg-warm">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-14">
        <p class="font-body text-muted text-xs uppercase tracking-[0.2em] mb-3">Zašto VAU</p>
        <h2 class="font-display text-4xl md:text-5xl text-ink mb-4">Ono što nas izdvaja</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center p-8">
          <ChefHat size={36} className="text-burgundy mx-auto mb-5" strokeWidth={1.5} />
          <h3 class="font-display text-xl text-ink font-medium mb-3">Domaća kuhinja</h3>
          <p class="text-ink-secondary leading-relaxed text-sm">
            Sva jela pripremaju se po tradicionalnim receptima sa svežim, lokalnim namirnicama.
          </p>
        </div>
        <div class="text-center p-8">
          <Truck size={36} className="text-gold mx-auto mb-5" strokeWidth={1.5} />
          <h3 class="font-display text-xl text-ink font-medium mb-3">Dostava na adresu</h3>
          <p class="text-ink-secondary leading-relaxed text-sm">
            Brza i pouzdana dostava hrane na vašu lokaciju u dogovorenom terminu.
          </p>
        </div>
        <div class="text-center p-8">
          <Calendar size={36} className="text-gold mx-auto mb-5" strokeWidth={1.5} />
          <h3 class="font-display text-xl text-ink font-medium mb-3">Za svaku priliku</h3>
          <p class="text-ink-secondary leading-relaxed text-sm">
            Rođendani, venčanja, poslovni ručkovi ili porodične proslave — mi smo tu.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* Featured Items */}
  <section id="ponuda" class="py-20 md:py-28 bg-white">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-14">
        <p class="font-body text-muted text-xs uppercase tracking-[0.2em] mb-3">Izdvajamo iz ponude</p>
        <h2 class="font-display text-4xl md:text-5xl text-ink mb-4">Najpopularnija jela</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {featuredItems.map((item) => (
          <a href={`${import.meta.env.BASE_URL}ponuda`} class="group block bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
            <div class="aspect-[4/3] overflow-hidden bg-cream">
              <img
                src={item.image}
                alt={item.name}
                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                loading="lazy"
              />
            </div>
            <div class="p-5">
              <span class="inline-block bg-gold-light text-gold text-xs font-medium px-3 py-1 rounded-full mb-2">{item.subcategoryName}</span>
              <h3 class="font-display text-xl text-ink mb-1 group-hover:text-burgundy transition-colors">{item.name}</h3>
              <p class="text-gold font-semibold text-lg">{item.price.toLocaleString('sr-RS')} RSD</p>
            </div>
          </a>
        ))}
      </div>

      <div class="text-center mt-12">
        <a
          href={`${import.meta.env.BASE_URL}ponuda`}
          class="inline-flex items-center gap-2 px-8 py-3 border-2 border-burgundy text-burgundy font-display text-sm uppercase tracking-widest rounded-xl hover:bg-burgundy hover:text-white transition-colors"
        >
          Pogledaj celu ponudu
          <ArrowRight size={16} />
        </a>
      </div>
    </div>
  </section>



  {/* Testimonials */}
