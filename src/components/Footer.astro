---
import { BUSINESS } from '../config/business';
import { Phone, MapPin, Mail, Instagram, MessageCircle } from 'lucide-react';
---

<footer class="bg-burgundy text-white/60">
  <div class="max-w-6xl mx-auto px-4 py-12 md:py-16 flex flex-col items-center gap-6">
    <h4 class="font-display text-sm uppercase tracking-[0.2em] text-white/40">Kontakt</h4>
    {/* Icons row */}
    <div class="flex items-center justify-center gap-4">
      <a
        href={`tel:${BUSINESS.phone}`}
        class="w-11 h-11 bg-white/5 rounded-full flex items-center justify-center hover:bg-white/10 hover:text-white transition-colors"
        aria-label="Pozovite nas"
      >
        <Phone size={18} strokeWidth={1.5} />
      </a>
      <a
        href={`mailto:${BUSINESS.email}`}
        class="w-11 h-11 bg-white/5 rounded-full flex items-center justify-center hover:bg-white/10 hover:text-white transition-colors"
        aria-label="Pošaljite email"
      >
        <Mail size={18} strokeWidth={1.5} />
      </a>
      <a
        href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(BUSINESS.address + ', Novi Sad, Serbia')}`}
        target="_blank"
        rel="noopener noreferrer"
        class="w-11 h-11 bg-white/5 rounded-full flex items-center justify-center hover:bg-white/10 hover:text-white transition-colors"
        aria-label="Prikaži na mapi"
      >
        <MapPin size={18} strokeWidth={1.5} />
      </a>
      <a
        href={`https://wa.me/${BUSINESS.whatsappNumber}`}
        target="_blank"
        rel="noopener noreferrer"
        class="w-11 h-11 bg-white/5 rounded-full flex items-center justify-center hover:bg-white/10 hover:text-white transition-colors"
        aria-label="WhatsApp"
      >
        <MessageCircle size={18} strokeWidth={1.5} />
      </a>
      <a
        href={BUSINESS.instagram}
        target="_blank"
        rel="noopener noreferrer"
        class="w-11 h-11 bg-white/5 rounded-full flex items-center justify-center hover:bg-white/10 hover:text-white transition-colors"
        aria-label="Instagram"
      >
        <Instagram size={18} strokeWidth={1.5} />
      </a>
    </div>

    {/* Copyright */}
    <p class="font-body text-xs text-white/25 text-center">
      © {new Date().getFullYear()} VAU Ketering. Sva prava zadržana.
    </p>
  </div>
</footer>
