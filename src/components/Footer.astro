---
import { BUSINESS } from '../config/business';
import { Phone, MapPin, Mail, Instagram, MessageCircle } from 'lucide-react';

const BASE = import.meta.env.BASE_URL;
---

<footer class="bg-burgundy-dark text-white/60">
  <div class="max-w-7xl mx-auto px-4 py-12 md:py-16">
    {/* Top section: Logo + Tagline + Contact Icons - All centered */}
    <div class="flex flex-col items-center gap-6 mb-10">
      {/* Logo */}
      <img src={`${BASE}logo.png`} alt="VAU Ketering" class="h-12 w-auto" />
      
      {/* Tagline */}
      <p class="text-white/80 text-sm">Ketering za sve prilike</p>
      
      {/* Contact Icons */}
      <div class="flex items-center gap-4">
        <a
          href={`tel:${BUSINESS.phone}`}
          class="w-11 h-11 bg-white/5 rounded-full flex items-center justify-center hover:bg-gold/20 hover:text-gold transition-colors"
          aria-label="Pozovite nas"
        >
          <Phone size={18} strokeWidth={1.5} />
        </a>
        <a
          href={`mailto:${BUSINESS.email}`}
          class="w-11 h-11 bg-white/5 rounded-full flex items-center justify-center hover:bg-gold/20 hover:text-gold transition-colors"
          aria-label="Pošaljite email"
        >
          <Mail size={18} strokeWidth={1.5} />
        </a>
        <a
          href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(BUSINESS.address + ', Novi Sad, Serbia')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="w-11 h-11 bg-white/5 rounded-full flex items-center justify-center hover:bg-gold/20 hover:text-gold transition-colors"
          aria-label="Prikaži na mapi"
        >
          <MapPin size={18} strokeWidth={1.5} />
        </a>
        <a
          href={`https://wa.me/${BUSINESS.whatsappNumber}`}
          target="_blank"
          rel="noopener noreferrer"
          class="w-11 h-11 bg-white/5 rounded-full flex items-center justify-center hover:bg-gold/20 hover:text-gold transition-colors"
          aria-label="WhatsApp"
        >
          <MessageCircle size={18} strokeWidth={1.5} />
        </a>
        <a
          href={BUSINESS.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="w-11 h-11 bg-white/5 rounded-full flex items-center justify-center hover:bg-gold/20 hover:text-gold transition-colors"
          aria-label="Instagram"
        >
          <Instagram size={18} strokeWidth={1.5} />
        </a>
      </div>
    </div>

    {/* Copyright */}
    <p class="text-white/30 text-xs text-center mt-10">
      &copy; {new Date().getFullYear()} VAU Ketering. Sva prava zadržana.
    </p>
  </div>
</footer>
